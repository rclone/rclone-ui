msgstr "la actualización no es un paquete de aplicación: %w"

#: app/update/update.go
msgid "this copy of Rclone UI can't update itself"
msgstr "esta copia de Rclone UI no puede actualizarse sola"

#. Path1 and Path2 are rclone's names for the two folders of a bisync. "force" is the bisync option of that name.
#: core/operations/bisyncerr.go
msgid "too many deletes on Path1: bisync stopped before deleting the same files on Path2. Run it with force to delete them there too"
msgstr "demasiadas eliminaciones en Path1: Bisync se detuvo antes de eliminar los mismos archivos en Path2. Ejecútalo con force para eliminarlos también allí"

#. Path1 and Path2 are rclone's names for the two folders of a bisync. "force" is the bisync option of that name.
#: core/operations/bisyncerr.go
msgid "too many deletes on Path2: bisync stopped before deleting the same files on Path1. Run it with force to delete them there too"
msgstr "demasiadas eliminaciones en Path2: Bisync se detuvo antes de eliminar los mismos archivos en Path1. Ejecútalo con force para eliminarlos también allí"

#. "force" is the bisync option of that name.
#: core/operations/bisyncerr.go
msgid "too many deletes: bisync stopped before deleting the same files on the other side. Run it with force to delete them there too"
msgstr "demasiadas eliminaciones: Bisync se detuvo antes de eliminar los mismos archivos en el otro lado. Ejecútalo con force para eliminarlos también allí"


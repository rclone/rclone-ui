#: lib/paths.ts
msgid "‘{name}’ cannot be a remote name. A name may contain letters, digits, spaces and _ - . + @, and cannot start with - or a space."
msgstr "“{name}” no puede ser el nombre de un remoto. Un nombre puede tener letras, números, espacios y _ - . + @, y no puede empezar por - ni por un espacio."

#: src/components/navigator/selection.ts
msgid "“{name}” is selected, so its contents are included already. Unselect it to choose items inside it."
msgstr "“{name}” está seleccionada, así que su contenido ya está incluido. Deselecciónala para elegir elementos de su interior."

#: src/pages/Wizard/flow.ts
msgid "\"Just once\" means it runs when you start it, and that is all."
msgstr "“Solo una vez” significa que se ejecuta cuando la inicias, y nada más."

#: src/pages/Wizard/flow.ts
msgid "\"Keep them\" leaves the source as it is. \"Take them away\" removes each file from the source once it has safely arrived."
msgstr "“Conservarlos” deja el origen como está. “Quitarlos” elimina cada archivo del origen en cuanto llega sin problemas al destino."

#: src/pages/Wizard/flow.ts
msgid "\"Only the files\" deletes the files inside the folder and leaves the folders. Filters set on the Delete page narrow down which files go."
msgstr "“Solo los archivos” elimina los archivos de la carpeta y conserva las carpetas. Los filtros que pongas en la ventana Eliminar limitan qué archivos se eliminan."

#: src/pages/Wizard/flow.ts
msgid "\"The folder and everything in it\" deletes the folder itself with everything in it, whatever the filters. It cannot be undone."
msgstr "“La carpeta y todo su contenido” elimina la propia carpeta con todo lo que contiene, sin importar los filtros. No se puede deshacer."


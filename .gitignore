# tracked so `npm ci` can resolve the workspace without the rest of the directory.
src-video/*
!src-video/package.json

# Cargo workspace build output
/target

# Playwright
/src-frontend/e2e/.tmp
/src-frontend/test-results
/src-frontend/playwright-report

# dummy-storage/ is an example of the app's data directory; its logs are part of the example.
!/dummy-storage/logs/
!/dummy-storage/scheduler/logs/
!/dummy-storage/**/*.log

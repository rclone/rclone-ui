        "@lingui/format-po": "^6.12.0",
        "@lingui/vite-plugin": "^6.12.0",
        "@tailwindcss/vite": "^4.3.5",
        "@total-typescript/ts-reset": "^0.6.1",
        "@types/node": "^24.19.2",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.2.1",
        "tailwindcss": "^4.3.5",
        "typescript": "^7.0.2",
        "vite": "^8.3.6",
        "vitest": "^5.1.0"
    }
}

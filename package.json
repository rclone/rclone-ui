{
    "name": "rclone-ui",
    "version": "3.7.4",
    "description": "The GUI for rclone & s3",
    "author": {
        "name": "Rclone UI",
        "url": "https://github.com/rclone-ui/rclone-ui"
    },
    "type": "module",
    "repository": {
        "type": "git",
        "url": "https://github.com/rclone-ui/rclone-ui"
    },
    "homepage": "https://rcloneui.com",
    "keywords": ["rclone", "gui", "drive", "s3", "cloud", "storage", "sync", "backup"],
    "license": "Apache-2.0",
    "workspaces": ["src-frontend"],
    "scripts": {
        "dev": "npm run dev -w src-frontend",
        "build": "npm run build -w src-frontend",
        "test:e2e": "npm run test:e2e -w src-frontend",
        "build:server": "npm run build && cargo build --release -p rclone-ui-server",
        "dev:server": "cargo run -p rclone-ui-server -- serve --dev-proxy http://localhost:1420 --password rclone",
        "docker:build": "docker build -t rclone-ui-server .",
        "check:no-tauri": "npm run check:no-tauri -w src-frontend"
    },
    "devDependencies": {
        "@biomejs/biome": "^1.9.4"
    }
}
